generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  IMAGE
  VIDEO
}

enum SubOrderStatus {
  OPEN
  CLOSED
  CANCELED
}

enum UserRole {
  CONSIGNEE
  OPERATOR
  COMPANY
  EMPLOYEE
  // A "company for tracking" — mirrors COMPANY but on the operator side: it
  // never tracks orders itself, only its OPERATOR employees (companyId set)
  // do. Never confuse this with COMPANY, which is a "company for orders".
  OPERATOR_COMPANY
}

enum DriverAssignmentStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum OperatorLinkScope {
  ALL
  SELECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole

  // Used by COMPANY/OPERATOR_COMPANY only — the company's display name (individuals use firstName/lastName instead).
  companyName String?

  firstName   String?
  lastName    String?
  phone       String?
  photoUrl    String?
  dateOfBirth DateTime? @db.Date

  // EMPLOYEE/company-employed OPERATOR only: deactivating blocks login but
  // keeps their work intact (an employee's orders stay with the company —
  // see companyId below; an operator's links/history are untouched).
  active Boolean @default(true)

  // EMPLOYEE only: the COMPANY this employee belongs to. Orders an employee
  // creates are owned by the company (ownerId = companyId), not the
  // employee, so removing an employee never touches order ownership.
  //
  // Also reused for OPERATOR: the OPERATOR_COMPANY ("company for tracking")
  // this operator belongs to, if any — a standalone OPERATOR leaves this
  // null. This is a different relationship from the one above (no order
  // ownership is involved) but the same self-referential FK serves both,
  // same as active above.
  companyId String?
  company   User?   @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: Cascade)
  employees User[]  @relation("CompanyEmployees")

  linkCode String @unique

  createdAt DateTime @default(now())

  ownedOrders      GroupOrder[]    @relation("OrderOwner")
  createdOrders    GroupOrder[]    @relation("OrderCreator")
  linksAsConsignee OperatorLink[]  @relation("ConsigneeLinks")
  linksAsOperator  OperatorLink[]  @relation("OperatorLinks")

  // COMPANY ("company for orders") <-> OPERATOR_COMPANY ("company for
  // tracking") partnerships — a completely different relationship from
  // OperatorLink above: no scope, no per-order grants, just two companies
  // agreeing to see each other's roster (id + members' ids) so their
  // people know who to link with. Only COMPANY/OPERATOR_COMPANY accounts
  // create these; everyone in that company can view them.
  partnerLinksAsCompany         CompanyPartnerLink[] @relation("PartnerAsCompany")
  partnerLinksAsOperatorCompany CompanyPartnerLink[] @relation("PartnerAsOperatorCompany")

  @@index([companyId])
}

model CompanyPartnerLink {
  id String @id @default(cuid())

  companyId String
  company   User   @relation("PartnerAsCompany", fields: [companyId], references: [id], onDelete: Cascade)

  operatorCompanyId String
  operatorCompany   User   @relation("PartnerAsOperatorCompany", fields: [operatorCompanyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([companyId, operatorCompanyId])
  @@index([operatorCompanyId])
}

model OperatorLink {
  id String @id @default(cuid())

  consigneeId String
  consignee   User   @relation("ConsigneeLinks", fields: [consigneeId], references: [id], onDelete: Cascade)

  operatorId String
  operator   User   @relation("OperatorLinks", fields: [operatorId], references: [id], onDelete: Cascade)

  // ALL: operator sees every order this consignee owns, present and future.
  // SELECTED: operator only sees orders explicitly granted below.
  scope       OperatorLinkScope    @default(ALL)
  orderGrants OperatorOrderGrant[]

  createdAt DateTime @default(now())

  @@unique([consigneeId, operatorId])
  @@index([operatorId])
}

model OperatorOrderGrant {
  id String @id @default(cuid())

  operatorLinkId String
  operatorLink   OperatorLink @relation(fields: [operatorLinkId], references: [id], onDelete: Cascade)

  groupOrderId String
  groupOrder   GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([operatorLinkId, groupOrderId])
  @@index([groupOrderId])
}

model GroupOrder {
  id        String    @id @default(cuid())
  name      String
  openedAt  DateTime?
  arrivedAt DateTime?

  ownerId String?
  owner   User?   @relation("OrderOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Who actually clicked "create" — for a company's employee this differs
  // from ownerId (the company). Used for per-employee order stats; kept on
  // deletion (SetNull) so removing a user never touches the order itself.
  createdByUserId String?
  createdBy       User?   @relation("OrderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  pol         String?
  origin      String?
  destination String?
  commodity   String?

  statusText      String?
  statusUpdatedAt DateTime?

  // Set whenever a linked operator edits this order (e.g. POL) — shown to
  // the consignee so they know who last touched it.
  lastEditedByEmail String?
  lastEditedAt      DateTime?

  canceledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subOrders      SubOrder[]
  comments       Comment[]
  operatorGrants OperatorOrderGrant[]

  @@index([name])
  @@index([ownerId])
  @@index([createdByUserId])
}

model SubOrder {
  id        String         @id @default(cuid())
  name      String?
  openedAt  DateTime?
  arrivedAt DateTime?
  status    SubOrderStatus @default(OPEN)

  factoryLoadDate DateTime?

  statusText      String?
  statusUpdatedAt DateTime?

  // Set whenever a linked operator edits this sub-order or one of its
  // trucks — shown to the consignee so they know who last touched it.
  lastEditedByEmail String?
  lastEditedAt      DateTime?

  groupOrderId String
  groupOrder   GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trucks   Truck[]
  comments Comment[]

  @@index([groupOrderId])
  @@index([status])
}

model Truck {
  id String @id @default(cuid())

  subOrderId String
  subOrder   SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  plateNumber        String?
  trailerPlateNumber String?
  country            String?
  driverName         String?
  driverPhone        String?

  cargoWeight      Float?
  cargoDescription String?

  currentLocation   String?
  locationUpdatedAt DateTime?
  lastLat           Float?
  lastLng           Float?

  canceledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media    Media[]
  comments Comment[]

  transfersFrom CargoTransfer[] @relation("TransferFrom")
  transfersTo   CargoTransfer[] @relation("TransferTo")
  assignments   DriverAssignment[]

  @@index([subOrderId])
}

model CargoTransfer {
  id String @id @default(cuid())

  fromTruckId String
  fromTruck   Truck  @relation("TransferFrom", fields: [fromTruckId], references: [id], onDelete: Cascade)

  toTruckId String
  toTruck   Truck  @relation("TransferTo", fields: [toTruckId], references: [id], onDelete: Cascade)

  keepTrailer Boolean @default(false)
  fromPlate   String?
  toPlate     String?
  fromTrailer String?
  toTrailer   String?

  transferDate DateTime?
  comment      String?

  createdAt DateTime @default(now())

  @@index([fromTruckId])
  @@index([toTruckId])
}

model DriverAssignment {
  id String @id @default(cuid())

  truckId String
  truck   Truck  @relation(fields: [truckId], references: [id], onDelete: Cascade)

  phoneNormalized String
  pairingCodeHash String?
  pairingExpiresAt DateTime?
  status          DriverAssignmentStatus @default(PENDING)
  tokenVersion    Int                    @default(0)
  claimedAt       DateTime?

  lastLat          Float?
  lastLng          Float?
  lastLocationText String?
  lastPingAt       DateTime?

  createdByUserId String?
  createdByLabel  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pings LocationPing[]

  @@index([phoneNormalized, status])
  @@index([truckId, status])
}

model LocationPing {
  id String @id @default(cuid())

  assignmentId String
  assignment   DriverAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  lat          Float
  lng          Float
  accuracy     Float?
  locationText String?

  recordedAt DateTime @default(now())

  @@index([assignmentId, recordedAt])
}

model Media {
  id String @id @default(cuid())

  truckId String
  truck   Truck  @relation(fields: [truckId], references: [id], onDelete: Cascade)

  url      String
  type     MediaType
  fileName String?

  createdAt DateTime @default(now())

  @@index([truckId])
}

model Comment {
  id   String @id @default(cuid())
  text String

  groupOrderId String?
  groupOrder   GroupOrder? @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)

  subOrderId String?
  subOrder   SubOrder? @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  truckId String?
  truck   Truck?  @relation(fields: [truckId], references: [id], onDelete: Cascade)

  author String?

  createdAt DateTime @default(now())

  @@index([groupOrderId])
  @@index([subOrderId])
  @@index([truckId])
}
