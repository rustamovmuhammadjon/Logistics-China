# =============================================================================
# Backend environment variables
# Copy this file to .env  (apps/backend/.env)
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
# Where: Neon → https://neon.tech → New Project → Connection string
#   or any Postgres host (Supabase Database, Railway, local Docker).
# Looks like: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Admin login (no database row — env-only account) ------------------------
# Where: you choose these yourself. Keep the password strong.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# --- Invite code for /register ----------------------------------------------
# Where: you choose this. Share only with people who should see monitoring data.
REGISTRATION_CODE="change-me-too"

# --- Session signing secret --------------------------------------------------
# Where: generate locally, never reuse across environments:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Frontend middleware uses the SAME value (apps/frontend/.env.local SESSION_SECRET).
SESSION_SECRET=""

# --- Frontend origin (CORS + cookie-friendly redirects) ----------------------
# Where: the URL of the Next.js app. Local default is http://localhost:3000
FRONTEND_URL="http://localhost:3000"
PORT="4000"

# --- Supabase Storage (photo / video uploads) --------------------------------
# Where:
#   1. Create a project at https://supabase.com/dashboard
#   2. Project Settings → API
#        Project URL          → SUPABASE_URL
#        service_role         → SUPABASE_SERVICE_ROLE_KEY
#          This is the LONG secret JWT. It starts with eyJ and is 200+ characters.
#          Reveal it, then copy. Do NOT use the anon/public key.
#   3. Storage → New bucket named "logistics", Public = ON
#      (the backend will also create this bucket if the service_role key is valid)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="logistics"
