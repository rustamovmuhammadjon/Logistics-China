# =============================================================================
# Backend environment variables
# Copy this file to .env  (apps/backend/.env)
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
# Where: Neon → https://neon.tech → New Project → Connection string
#   or any Postgres host (Supabase Database, Railway, local Docker).
# Looks like: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Admin login (no database row — env-only account) ------------------------
# Where: you choose these yourself. Keep the password strong.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# --- Invite code for /register ----------------------------------------------
# Where: you choose this. Share only with people who should see monitoring data.
REGISTRATION_CODE="change-me-too"

# --- Session signing secret --------------------------------------------------
# Where: generate locally, never reuse across environments:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Frontend middleware uses the SAME value (apps/frontend/.env.local SESSION_SECRET).
SESSION_SECRET=""

# --- Frontend origin (CORS + cookie-friendly redirects) ----------------------
# Where: the URL of the Next.js app. Local default is http://localhost:3000
FRONTEND_URL="http://localhost:3000"
PORT="4000"

# --- Supabase Storage (photo / video uploads) --------------------------------
# Where:
#   1. Create a project at https://supabase.com/dashboard
#   2. Project Settings → API
#        Project URL          → SUPABASE_URL
#        service_role         → SUPABASE_SERVICE_ROLE_KEY
#          This is the LONG secret JWT. It starts with eyJ and is 200+ characters.
#          Reveal it, then copy. Do NOT use the anon/public key.
#   3. Storage → New bucket named "logistics", Public = ON
#      (the backend will also create this bucket if the service_role key is valid)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="logistics"
# Optional. Truck shipping documents go in a separate PRIVATE bucket (created
# automatically on the first upload, with the 15 MB / PDF+Word limits set on
# it). Defaults to "shipping-documents".
# SUPABASE_DOCUMENTS_BUCKET="shipping-documents"

# --- track718 (China-leg GPS box tracking) ------------------------------------
# Where:
#   1. track718.com → Setting → Get API Key            → TRACK718_API_KEY
#   2. track718.com → Setting → Member Details          → TRACK718_ACCOUNT_EMAIL
#      (used to verify the webhook payload's signature)
#   3. Generate your own random secret for the URL path (this is NOT from
#      track718 — it's what stops randoms from POSTing fake data to us):
#        node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#      Then in track718.com → Setting → Webhook, set the URL to:
#        https://YOUR-BACKEND-DOMAIN/webhooks/track718/YOUR_TOKEN
TRACK718_API_KEY=""
TRACK718_BASE_URL="https://apigetway.track718.net"
TRACK718_ACCOUNT_EMAIL=""
TRACK718_WEBHOOK_TOKEN=""
TRACK718_DEFAULT_TZ="+08:00"

# --- Telegram daily Bukhara-arrivals report -----------------------------------
# Where:
#   1. Telegram → @BotFather → /newbot → follow the prompts → copy the token
#      it gives you                                       → TELEGRAM_BOT_TOKEN
#   2. Add that bot to the group it should post in.
#   3. Get the group's chat id: send any message in the group, then open
#        https://api.telegram.org/bot<TOKEN>/getUpdates
#      and read the "chat":{"id": ...} value (negative number for a group).
#      → TELEGRAM_CHAT_ID
# Sends automatically every day at 09:00 Asia/Tashkent; does nothing if unset.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
