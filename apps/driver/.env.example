# Local emulator only (Android Studio → host machine):
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Physical phone on the same Wi-Fi (replace with your PC IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.23:4000

# Production APK: put the LIVE Vercel frontend URL (no trailing slash, no /api).
# Also paste the same value into eas.json → build.preview.env.EXPO_PUBLIC_API_URL
# EXPO_PUBLIC_API_URL=https://your-site.vercel.app
