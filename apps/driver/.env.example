# Local emulator only (Android Studio → host machine):
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Physical phone on the same Wi-Fi (replace with your PC IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.23:4000

# Production APK: the Railway backend itself (no trailing slash, no /api).
# The Vercel site proxies /api too, but going through it adds ~0.3 s to every
# request from Central Asia. Keep eas.json → build.*.env.EXPO_PUBLIC_API_URL
# the same.
# EXPO_PUBLIC_API_URL=https://backend-production-654f.up.railway.app
