# =============================================================================
# Frontend environment variables
# Copy this file to .env.local  (apps/frontend/.env.local)
# =============================================================================

# Express API origin. Used by:
#   - next.config.ts rewrites so the browser can call /api/* on port 3000
#   - Server Components that fetch the backend directly
# Where: you choose this. Local default is http://localhost:4000
BACKEND_URL="http://localhost:4000"

# Same signing secret as apps/backend/.env SESSION_SECRET
# Where: generate once and paste into BOTH apps:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used by Next.js middleware to verify the session cookie without a round-trip.
SESSION_SECRET=""
