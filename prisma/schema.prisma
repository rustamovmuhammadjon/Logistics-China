generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  NOT_PAID
  PAID
}

enum MediaType {
  IMAGE
  VIDEO
}

enum SubOrderStatus {
  OPEN
  CLOSED
}

// A top-level shipment order, e.g. "SADAR26075" or "Buxoro"
model GroupOrder {
  id              String    @id @default(cuid())
  name            String
  openedAt        DateTime?
  arrivedAt       DateTime?

  // General shipment info (mirrors the "China side" tracking sheet)
  pol             String? // place of loading
  origin          String? // where the cargo is coming from
  destination     String? // where the cargo is going to
  commodity       String?
  volumeInfo      String? // free text, e.g. "8xFTL"
  factoryLoadDate DateTime?

  // Free-text current status / location for the overall order, e.g. "Arrived in Bukhara"
  statusText      String?
  statusUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subOrders SubOrder[]
  comments  Comment[]

  @@index([name])
}

// A batch of trucks inside a group order. Closes automatically once it has an arrival date.
model SubOrder {
  id        String         @id @default(cuid())
  name      String?
  openedAt  DateTime?
  arrivedAt DateTime?
  status    SubOrderStatus @default(OPEN)

  groupOrderId String
  groupOrder   GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trucks   Truck[]
  comments Comment[]

  @@index([groupOrderId])
  @@index([status])
}

// A single truck carrying (part of) a shipment
model Truck {
  id String @id @default(cuid())

  subOrderId String
  subOrder   SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  plateNumber        String?
  trailerPlateNumber String?
  driverName         String?
  driverPhone        String?

  lengthM Float?
  widthM  Float?
  heightM Float?

  cargoWeight      Float?
  cargoDescription String?

  currentLocation   String?
  locationUpdatedAt DateTime?

  driverPaymentStatus   PaymentStatus @default(NOT_PAID)
  customerPaymentStatus PaymentStatus @default(NOT_PAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media    Media[]
  comments Comment[]

  transfersFrom CargoTransfer[] @relation("TransferFrom")
  transfersTo   CargoTransfer[] @relation("TransferTo")

  @@index([subOrderId])
}

// Records cargo being moved from one truck to another (перекид)
model CargoTransfer {
  id String @id @default(cuid())

  fromTruckId String
  fromTruck   Truck @relation("TransferFrom", fields: [fromTruckId], references: [id], onDelete: Cascade)

  toTruckId String
  toTruck   Truck @relation("TransferTo", fields: [toTruckId], references: [id], onDelete: Cascade)

  transferDate DateTime?
  comment      String?

  createdAt DateTime @default(now())

  @@index([fromTruckId])
  @@index([toTruckId])
}

// Photo / video attached to a truck
model Media {
  id String @id @default(cuid())

  truckId String
  truck   Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  url      String
  type     MediaType
  fileName String?

  createdAt DateTime @default(now())

  @@index([truckId])
}

// A comment can be attached to a group order, a sub order, or a truck
// (exactly one of the three ids is set, enforced in application code)
model Comment {
  id   String @id @default(cuid())
  text String

  groupOrderId String?
  groupOrder   GroupOrder? @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)

  subOrderId String?
  subOrder   SubOrder? @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  truckId String?
  truck   Truck? @relation(fields: [truckId], references: [id], onDelete: Cascade)

  author String?

  createdAt DateTime @default(now())

  @@index([groupOrderId])
  @@index([subOrderId])
  @@index([truckId])
}
