# PostgreSQL connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Vercel Blob storage token (from Vercel dashboard -> Storage -> Blob)
BLOB_READ_WRITE_TOKEN=""

# Admin panel login (full read/write access)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Invite code required to self-register a read-only viewer account at /register.
# Share this only with people you trust to see the monitoring data.
REGISTRATION_CODE="change-me-too"

# Random long random string used to sign session cookies (both admin and viewer)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
