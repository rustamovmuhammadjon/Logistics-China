public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=*react-native*
# Expo's packages import "react" in their .d.ts files but never get
# @types/react linked beside them — without this their class components
# (LinearGradient, CameraView) type-check as having no props.
public-hoist-pattern[]=@types/react
